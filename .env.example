# Android emulator local API default: http://10.0.2.2:5001/v1
EXPO_PUBLIC_API_URL=https://api.example.com/v1
# Required for Play Integrity attestation in staging/production.
EXPO_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
# EAS project UUID used to obtain Expo push tokens in development/production builds.
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
